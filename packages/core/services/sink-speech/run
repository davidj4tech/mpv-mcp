#!/data/data/com.termux/files/usr/bin/sh
# Speech sink: long-running mpv broker for TTS playback.
# Socket: $XDG_STATE_HOME/agent-media/sink-speech.sock
#
# AO prefers pulse when a sound server is actually answering, else openal —
# which survives BT route changes on Termux (2026-05-14). On a PipeWire/Pulse
# host pulse is also what makes per-clip `audio-device=pulse/<sink>` routing
# (decision 1C) work; the openal AO doesn't understand pulse device ids.
#
# The probe exists because the openal/opensles AOs open the Android audio
# device DIRECTLY, and the device only hands out so many engines. The phone
# runs five idle mpv brokers (speech, book, music, voice, generic) beside up to
# three snapclients, and once they have taken the engines between them every
# later open fails with a bare "could not open device" — mpv then drops the
# file and exits 0, so say.sh reports CLIP/DURATION and the reply is simply
# never heard. Nothing upstream can tell that apart from success. Silent since
# ~2026-08-09 09:17 on p8a; found 2026-08-10.
#
# pulseaudio holds ONE engine and mixes every client into it, so routing the
# brokers through it removes the contention entirely rather than racing for a
# scarce resource. Probe rather than hardcode: `pactl info` answering is the
# only reliable evidence a server is up, and if it isn't, openal direct is
# still the best available fallback.
exec 2>&1
# WAIT for the sound server before deciding, do not just probe once.
#
# The AO is chosen at startup and then fixed for the life of this long-running
# mpv, so losing the race costs the whole session, not a moment. On 2026-08-11 a
# Termux restart brought this broker up ~seconds before pulseaudio and it locked
# onto openal for over an hour: every reply rendered, `loadfile` returned
# success, speech-events logged start AND end, and nothing was audible — because
# openal opens the Android audio device directly and the later opens fail into a
# bare "could not open device" that mpv reports as a played file. Silent success
# is the worst shape this failure can take, and a one-shot probe invites it on
# every restart where ordering is not guaranteed (a Termux app restart does not
# replay .termux/boot, so the documented "pulseaudio starts first" guarantee
# holds for boots and not for restarts).
#
# ~15s of patience, then fall back exactly as before. Bounded, because a device
# with no pulseaudio at all must still get speech through openal rather than
# spinning here forever.
# pactl needs XDG_RUNTIME_DIR to find the server, and a runit service has no
# such variable — the interactive profile sets it, runsv does not pass it, and
# nothing in between fills it in. So the probe below asked pactl, pactl looked
# in the wrong place, got "Connection refused", and this broker fell back to
# openal with pulseaudio running healthily three metres away.
#
# That is not a cosmetic fallback: openal opens the Android device directly, the
# device is already held, and mpv then reports every clip as played with no
# sound. Found 2026-08-17 while chasing "I can't seem to play the last clip" —
# the clip was fine, the broker had been deaf since its last restart, and every
# `sv restart` of these sinks had been doing this quietly.
#
# $HOME/tmp is where .termux/boot/start-services puts the pulse socket.
: "${XDG_RUNTIME_DIR:=$HOME/tmp}"
export XDG_RUNTIME_DIR
if [ -z "${MEDIA_SPEECH_AO:-}" ]; then
  MEDIA_SPEECH_AO=openal
  if command -v pactl >/dev/null 2>&1; then
    i=0
    while [ "$i" -lt 30 ]; do
      if pactl info >/dev/null 2>&1; then
        MEDIA_SPEECH_AO=pulse
        break
      fi
      i=$((i + 1))
      sleep 0.5
    done
  fi
  [ "$MEDIA_SPEECH_AO" = openal ] &&
    echo "sink-speech: no pulseaudio after ~15s, falling back to ao=openal (expect silent playback if other clients hold the device)"
fi
echo "sink-speech: ao=$MEDIA_SPEECH_AO"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/agent-media"
SOCK="$STATE/sink-speech.sock"
mkdir -p "$STATE"
rm -f "$SOCK"
# Pitch correction must stay ON. `audio-pitch-correction=no` does NOT merely
# suppress a second auto-inserted scaletempo2 (an older comment here claimed
# that) — it makes mpv apply speed by RESAMPLING and never hand the speed to
# any scaletempo2, pinned or not, so speech chipmunks. Measured on mpv 0.40 with
# a 200 Hz tone at 1.5×: `=no` → 300 Hz (+7 semitones), `=yes` → 201 Hz.
#
# Whether scaletempo2 is *pinned* is decided further down, and is no longer
# unconditional: pinning cost the live speed change, which is a worse bargain
# than the underrun it bought. See the note beside the filter chain.
#
# Belt-and-suspenders: pin one output format so a clip whose native rate/
# channels differ from the previous one can't force the same AO reinit at a
# boundary. 48 kHz / s16 / stereo is the devices' native format here, so this
# never makes the *device* itself resample. All overridable per host.
: "${MEDIA_SPEECH_SAMPLERATE:=48000}"
: "${MEDIA_SPEECH_FORMAT:=s16}"
: "${MEDIA_SPEECH_CHANNELS:=stereo}"
# Louder default. --volume is mpv's *software* gain; 100 is nominal, so to go
# above it we also lift --volume-max (mpv clamps --volume to it). Amplifying
# past 100 risks clipping on already-hot clips — that's exactly what the
# loudness filter below guards against by normalizing peaks. Both overridable.
: "${MEDIA_SPEECH_VOLUME:=130}"
: "${MEDIA_SPEECH_VOLUME_MAX:=200}"
# Per-stream loudness normalization (EBU R128-ish). Each channel is its own
# mpv/Mopidy, so we can't read the music's live level — but pulling every
# stream toward one target loudness makes speech sit at the same perceived
# level as the music instead of booming or vanishing under it. dynaudnorm is
# frame-based (works on short TTS clips with no two-pass/startup lag, unlike
# loudnorm). Set MEDIA_SPEECH_LOUDNORM= (empty) to disable.
# maxgain is the real ceiling on *quiet* clips: dynaudnorm won't amplify a
# frame beyond it even to reach targetrms, so a low maxgain leaves quiet TTS
# quiet no matter how high --volume goes. Raised to 30 so soft clips actually
# reach the target loudness; targetrms=0.95 pushes the resting level up too.
: "${MEDIA_SPEECH_LOUDNORM:=dynaudnorm=targetrms=0.95:maxgain=30:gausssize=15}"
# Pinning scaletempo2 costs live speed changes, so it is now done only where it
# pays for itself: on openal.
#
# The pin was added because mpv inserts scaletempo2 the moment speed leaves 1.0×
# and removes it on the way back, and each rebuild of the filter graph re-inits
# the audio output — which openal, opening the Android device directly, turns
# into an audible underrun. All true. What went unmeasured is what the pin does
# to a speed change on the clip already playing: **nothing reaches the audio**.
# Measured on p8a 2026-08-17, muted, 8 s samples on this broker:
#
#     pinned scaletempo2,  speed 1.6  ->  1.18× actual
#     auto-inserted,       speed 1.6  ->  1.64× actual
#
# The property reads back 1.6 either way, and the new rate takes effect on the
# *next* file, because that is when the graph is rebuilt. Reported as "the speed
# control only changes the next sentence, not the current line", which is
# exactly what a pinned filter that never receives the speed looks like.
#
# So: unpinned wherever the AO is a mixing server (pulse on both hosts today,
# which is what the probe above chooses whenever pulseaudio is up), and pinned
# on the openal fallback, where the underrun is real and a speed change is the
# rarer event. Being wrong on openal costs a click when you change speed; being
# wrong on pulse cost the speed control itself.
case "$MEDIA_SPEECH_AO" in
  openal|opensles) AF="scaletempo2" ;;
  *) AF="" ;;
esac
if [ -n "$MEDIA_SPEECH_LOUDNORM" ]; then
  AF="${AF:+$AF,}$MEDIA_SPEECH_LOUDNORM"
fi
exec mpv --idle=yes --ao="$MEDIA_SPEECH_AO" --force-window=no \
  --input-ipc-server="$SOCK" \
  --volume-max="$MEDIA_SPEECH_VOLUME_MAX" --volume="$MEDIA_SPEECH_VOLUME" \
  --keep-open=no \
  --gapless-audio=no --audio-stream-silence=no --ytdl=no \
  --network-timeout=60 \
  --af="$AF" --audio-pitch-correction="${MEDIA_SPEECH_PITCH_CORRECTION:-yes}" \
  --audio-samplerate="$MEDIA_SPEECH_SAMPLERATE" \
  --audio-format="$MEDIA_SPEECH_FORMAT" \
  --audio-channels="$MEDIA_SPEECH_CHANNELS"
