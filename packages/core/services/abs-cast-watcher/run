#!/bin/sh
# abs-cast-watcher — follows the Audiobookshelf app's live session. The phone
# is the primary player: by default this only logs what is playing there.
# CAST_AUTO=1 restores the reflex (cast the session to the book channel, then
# close it so the client stops); `media-abs-cast` does the same once, on request.
#
# Only a session whose position advances in real time twice running counts, so
# a tab left open for hours never seizes the speakers. CAST_DRY=1 to watch it
# decide without touching anything.
exec 2>&1
[ -f "$HOME/.config/agent-media.env" ] && . "$HOME/.config/agent-media.env"
exec media-abs-cast-watcher
